{
  "name": "@careerlens/api",
  "version": "1.0.0",
  "private": true,
  "description": "CareerLens AI API - resume parsing, job analysis, explainable matching and the optional AI provider adapter.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js --external:express --external:cors --external:pdf-parse --external:mammoth",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@careerlens/core": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
