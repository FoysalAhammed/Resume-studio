# CareerLens AI - example env file.
# Copy to `.env` and fill in only what you need. Without any of these the app
# still runs, including the sample workspace. `.env` is git-ignored, so never
# commit the real one.

# --- API server -----------------------------------------------------------
NODE_ENV=development
PORT=3001
# Origins allowed to call the API from a browser. Comma separated.
CORS_ORIGIN=http://localhost:5173

# --- Web app --------------------------------------------------------------
# API base URL as the browser sees it. Leave this empty on Vercel - the web app
# and the API share an origin there.
VITE_API_BASE_URL=http://localhost:3001

# --- Optional AI provider (server-side only) ------------------------------
# Leave AI_API_KEY empty and every feature uses local deterministic logic;
# /api/health reports mode: "local". Any OpenAI-compatible endpoint will do.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_CHARS=20000

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=6
