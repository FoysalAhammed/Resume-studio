# CareerLens AI - environment template
# Copy to `.env` and fill in only what you need. The whole application
# (including the sample demonstration workspace) runs with NO variables set.
#
# NEVER commit a real `.env` file. `.env` is git-ignored.

# --- API server -----------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Web app --------------------------------------------------------------
# Base URL of the API as used by the browser.
VITE_API_BASE_URL=http://localhost:3001

# --- Optional AI provider (server-side only) ------------------------------
# When AI_API_KEY is empty the API automatically uses deterministic local
# logic for every feature and reports `mode: "local"` on /api/health.
# Any OpenAI-compatible /chat/completions endpoint works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_CHARS=20000

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=6
